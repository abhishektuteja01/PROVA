# Anthropic
# Server-side only — referenced exclusively in src/lib/anthropic/client.ts
ANTHROPIC_API_KEY=

# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Supabase — server-side only — referenced exclusively in src/lib/supabase/server.ts
SUPABASE_SECRET_KEY=

# App — canonical origin, no trailing slash.
# Production: https://prova.abhishektuteja.com
# Local:      http://localhost:3000
#
# Two consumers, two failure modes if this is wrong:
#   1. OAuth/password-reset redirectTo (login, signup, reset-password, settings).
#      Inlined into the client bundle at build time — changing it in Vercel
#      requires a redeploy, not just a restart.
#   2. CSRF allowed origin in src/lib/supabase/middleware.ts — a mismatch makes
#      every state-changing /api/* request fail with 403, and an unset value
#      500s in production. Must be set for Preview as well as Production:
#      Vercel preview builds run with NODE_ENV=production.
#
# Changing the production domain also means updating Supabase → Authentication →
# URL Configuration (Site URL + Redirect URLs allowlist).
NEXT_PUBLIC_APP_URL=

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN is used by instrumentation-client.ts (browser)
# SENTRY_DSN is used by instrumentation.ts (server/edge)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Rate limiting — compliance checks per user per hour (default: 10)
RATE_LIMIT_REQUESTS_PER_HOUR=10
